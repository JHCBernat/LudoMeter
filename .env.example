# Server-side environment variables for LudoMeter
# NEVER expose these credentials to the client/browser!

PORT=3000
NODE_ENV=production

# Discord Credentials for "Les Ludophiles d'Asnières et d'ailleurs"
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_HISTORY_PATH=./data/discord_sessions_history.json
